#!/usr/bin/env bash

set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

[ "${ASDF_INSTALL_TYPE:-}" != "" ] || fail "ASDF_INSTALL_TYPE is required"
[ "${ASDF_INSTALL_VERSION:-}" != "" ] || fail "ASDF_INSTALL_VERSION is required"
[ "${ASDF_DOWNLOAD_PATH:-}" != "" ] || fail "ASDF_DOWNLOAD_PATH is required"

ref="$(version_ref "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION")"
download_source "$ref" "$ASDF_DOWNLOAD_PATH"
